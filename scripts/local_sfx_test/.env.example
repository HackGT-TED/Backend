# Copy to scripts/local_sfx_test/.env or the repo-root .env. Do not commit the copy.

# Required. https://console.x.ai/
XAI_API_KEY=

# Optional. grok-4.7 supports structured outputs.
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Folder of local clips named by catalog id (rain.mp3, door-creak.wav, ...).
# Empty uses scripts/local_sfx_test/catalog_clips/. The script also looks in
# assets/sfx_catalog/previews/.
SFX_CATALOG_DIR=

# Empty uses assets/sfx_catalog/catalog.json.
SFX_CATALOG_JSON=
