# Meta Model API key for Muse Spark chat completions.
# Meta's docs name this credential MODEL_API_KEY. This service reads MUSE_SPARK_API_KEY.
MUSE_SPARK_API_KEY=
# OpenAI-compatible base URL. Chat completions are POST {base}/chat/completions.
MUSE_SPARK_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# FreeSound APIv2 token (https://freesound.org/apiv2/apply).
FREESOUND_API_KEY=
FREESOUND_BASE_URL=https://freesound.org

# SQLAlchemy URL. SQLite is the local default; create_all runs on startup.
DATABASE_URL=sqlite:///./data/hackgt.db

# Optional. Reserved for a future direct Deepgram transcription path.
# v1 accepts Deepgram JSON the client already produced and does not call Deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en

MEDIA_DIR=./media
# Comma-separated browser origins, or * for local hackathon dev.
CORS_ORIGINS=*
HTTP_TIMEOUT_SECONDS=60
