# xAI API key for Chat Completions (https://console.x.ai/).
XAI_API_KEY=
# OpenAI-compatible base URL. Chat completions are POST {base}/chat/completions.
XAI_BASE_URL=https://api.x.ai/v1
# grok-4.7 supports structured outputs. Override if you want another chat model.
XAI_MODEL=grok-4.7
# Grok Imagine model for POST {XAI_BASE_URL}/images/generations.
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# FreeSound APIv2 token (https://freesound.org/apiv2/apply).
# Required by scripts/build_sfx_catalog.py. Story requests in catalog-only
# mode download the preview URLs already stored in catalog.json and do not
# send this token.
FREESOUND_API_KEY=
FREESOUND_BASE_URL=https://freesound.org
# Download the preview for a catalog id. Set to false to search FreeSound
# per cue instead.
FREESOUND_CATALOG_ONLY=true
# Optional file override. When set, the API reads this JSON and does not
# query Supabase for the catalog. Empty: active sfx_catalog row, then
# assets/sfx_catalog/catalog.json.
SFX_CATALOG_PATH=

# Supabase holds the SFX catalog JSON (the allowed sound library).
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY fetch and store that document.
# The same keys upload mixed story MP3s to SUPABASE_SFX_BUCKET.
# Marketplace and social sharing live in the frontend database, not here.
# The service role key stays on the server. SUPABASE_ANON_KEY is not read.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SFX_BUCKET=story-sfx

# Deepgram prerecorded listen API. Used by /stories/render, /stories/transcribe,
# and /stories/process-audio. /stories/process can still take Deepgram JSON directly.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Fallback for /stories/render when DEEPGRAM_API_KEY is empty. DeepGram.py
# uploads the file to Gladia and polls the pre-recorded job.
GLADIA_API_KEY=
# Comma-separated browser origins, or * for local hackathon dev.
CORS_ORIGINS=*
# Deepgram and FreeSound. xAI cue planning waits at least 180s, or this value if it is higher.
HTTP_TIMEOUT_SECONDS=60
